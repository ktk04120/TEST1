rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /submissions/{uid}/{fileName} {
      // 로그인한 계정 본인 폴더에만 업로드 가능
      allow write: if request.auth != null && request.auth.uid == uid;
      // 로그인한 사용자는 읽기 가능 (관리자가 파일 링크를 열람하기 위함)
      allow read: if request.auth != null;
    }
  }
}
